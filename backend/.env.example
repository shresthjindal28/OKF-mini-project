# Keep real secrets only in .env (ignored by git).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/okf?sslmode=require
HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIMENSION=384
# Empty disables optional metadata enrichment. Use a chat model listed by
# GET https://router.huggingface.co/v1/models (e.g. Qwen/Qwen3-4B-Instruct-2507).
HF_LLM_MODEL=
HF_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/{model}/pipeline/feature-extraction
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions
HF_TIMEOUT_SECONDS=60
HF_MAX_RETRIES=3
HF_BATCH_SIZE=16
HF_QUERY_PREFIX=
HF_DOCUMENT_PREFIX=
HF_LLM_MAX_INPUT_CHARS=16000
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_CHARS=2000000
MAX_PDF_PAGES=1000
MAX_DOCX_UNCOMPRESSED_MB=100
CHUNK_SIZE=180
CHUNK_OVERLAP=30
CORS_ORIGINS=["http://localhost:3000"]
MAX_CONCURRENT_PROCESSING=3
# Connection pool per worker; raise together with pooler limits under load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
LOG_LEVEL=INFO
# Separate disposable database recommended for integration tests.
TEST_DATABASE_URL=
